          "include": "#message-body"
        }
      ]
    },
    "group-block": {
      "begin": "(?:\\b(optional|required|repeated)\\s+)?\\b(group)\\b\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(=)\\s*(0[xX][0-9A-Fa-f]+|[0-9]+)",
      "beginCaptures": {
        "1": {
          "name": "storage.modifier.proto"
        },
        "2": {
          "name": "storage.type.group.proto"
        },
        "3": {
          "name": "entity.name.type.message.proto"
        },
        "4": {
          "name": "keyword.operator.assignment.proto"
        },
        "5": {
          "name": "constant.numeric.proto"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.block.end.proto"
        }
      },
      "patterns": [
