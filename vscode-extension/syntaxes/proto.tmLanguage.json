      "endCaptures": {
        "1": {
          "name": "punctuation.terminator.statement.proto"
        }
      },
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#range-keywords"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#field-options"
        },
        {
          "include": "#comma"
        }
      ]
    },
    "range-keywords": {
      "patterns": [
        {
          "name": "keyword.other.range.proto",
          "match": "\\b(?:to)\\b"
        },
        {
          "name": "constant.language.max.proto",
          "match": "\\b(?:max)\\b"
        }
      ]
    },
    "builtin-types": {
      "name": "support.type.builtin.proto",
      "match": "\\b(?:double|float|int32|int64|uint32|uint64|sint32|sint64|fixed32|fixed64|sfixed32|sfixed64|bool|string|bytes)\\b"
    },
    "type-reference": {
      "name": "entity.name.type.proto",
      "match": "(?!\\b(?:stream|returns|to|max|true|false|inf|nan)\\b)\\.?[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*"
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.proto",
          "begin": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.proto"
            }
          },
          "end": "(\")|(?=$)",
          "endCaptures": {
            "1": {
              "name": "punctuation.definition.string.end.proto"
            }
          },
          "patterns": [
            {
              "include": "#string-escapes"
            }
          ]
        },
        {
          "name": "string.quoted.single.proto",
          "begin": "'",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.proto"
            }
          },
          "end": "(')|(?=$)",
          "endCaptures": {
            "1": {
              "name": "punctuation.definition.string.end.proto"
            }
          },
          "patterns": [
            {
              "include": "#string-escapes"
            }
          ]
        }
      ]
    },
    "string-escapes": {
      "patterns": [
        {
          "name": "constant.character.escape.proto",
          "match": "\\\\(?:[abfnrtv?\\\\'\"]|[0-7]{1,3}|[xX][0-9A-Fa-f]{1,2}|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8})"
        },
        {
          "name": "invalid.illegal.unknown-escape.proto",
          "match": "\\\\."
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.proto",
          "match": "[+-]?(?:(?:[0-9]+\\.[0-9]*|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?|[0-9]+[eE][+-]?[0-9]+)"
        },
        {
          "name": "constant.numeric.hex.proto",
          "match": "[+-]?0[xX][0-9A-Fa-f]+\\b"
        },
        {
          "name": "constant.numeric.octal.proto",
          "match": "[+-]?0[0-7]+\\b"
        },
        {
          "name": "constant.numeric.integer.proto",
          "match": "[+-]?[0-9]+\\b"
        }
      ]
    },
    "language-constants": {
      "name": "constant.language.proto",
      "match": "\\b(?:true|false)\\b|[-+]?\\b(?:inf|nan)\\b"
    },
    "assignment": {
      "name": "keyword.operator.assignment.proto",
      "match": "="
    },
    "terminator": {
      "name": "punctuation.terminator.statement.proto",
      "match": ";"
    },
    "comma": {
      "name": "punctuation.separator.comma.proto",
      "match": ","
    },
    "key-value": {
      "name": "punctuation.separator.key-value.proto",
      "match": ":"
    },
    "block-open": {
      "name": "punctuation.section.block.begin.proto",
      "match": "\\{"
    }
  }
}
