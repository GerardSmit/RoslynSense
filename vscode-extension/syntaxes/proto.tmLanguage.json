        {
          "match": "([A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*)(?=\\s*=)",
          "captures": {
            "1": {
              "name": "variable.other.option.proto"
            }
          }
        },
        {
          "include": "#assignment"
        },
        {
          "include": "#option-aggregate"
        },
        {
          "include": "#option-aggregate-angle"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#language-constants"
        },
        {
