<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!--
    The never-built path. The project references the protobuf runtime and lists its schema as a
    <Protobuf> item, so it is a project protoc is meant to generate from - but Grpc.Tools is
    absent and no generated C# is committed, which is exactly the state a fresh checkout of a
    contracts project is in before anything has been built. Nothing here may ever gain a
    generated counterpart: the whole point of the fixture is that the index stays empty.
  -->
  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.32.1" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="contracts.proto" />
  </ItemGroup>

</Project>
