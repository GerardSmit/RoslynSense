        }
      },
      "end": "(;)|(?=\\})",
      "endCaptures": {
        "1": {
          "name": "punctuation.terminator.statement.proto"
        }
      },
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#range-keywords"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#numbers"
        },
        {
