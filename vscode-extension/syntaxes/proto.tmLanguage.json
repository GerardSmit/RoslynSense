    "field": {
      "comment": "The number is optional so a field keeps its colour while it is still being typed. The = is not: without it `optional group R = 1 {` would read as a field named group, and the group rule that precedes this one would only win on ordering.",
      "begin": "(?:\\b(optional|required|repeated)\\s+)?(?:\\b(double|float|int32|int64|uint32|uint64|sint32|sint64|fixed32|fixed64|sfixed32|sfixed64|bool|string|bytes)\\b|(?!\\b(?:option|reserved|extensions|message|enum|service|rpc|oneof|extend|import|package|syntax|edition|returns|stream|group|map|public|weak|to|max)\\b)(\\.?[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*))\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(=)\\s*(0[xX][0-9A-Fa-f]+|[0-9]+)?",
      "beginCaptures": {
        "1": {
          "name": "storage.modifier.proto"
        },
        "2": {
          "name": "support.type.builtin.proto"
        },
        "3": {
          "name": "entity.name.type.proto"
        },
        "4": {
          "name": "variable.other.field.proto"
        },
        "5": {
          "name": "keyword.operator.assignment.proto"
        },
        "6": {
          "name": "constant.numeric.proto"
        }
      },
      "end": "(;)|(?=\\})|(?=$)",
      "endCaptures": {
        "1": {
          "name": "punctuation.terminator.statement.proto"
        }
      },
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#field-options"
        }
      ]
    },
