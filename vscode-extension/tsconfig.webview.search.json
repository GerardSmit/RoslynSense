{
  // The Search Everywhere panel's browser-side script — same recipe as tsconfig.webview.json:
  // `module: none` plus `outFile` concatenates by the /// <reference> graph into one script.
  "compilerOptions": {
    "module": "none",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "outFile": "out/webview/search.js",
    "sourceMap": true,
    "strict": true,
    "skipLibCheck": true
  },
  "files": [
    "src/search/protocol.d.ts",
    "src/webview/search/highlight.ts",
    "src/webview/search/main.ts"
  ]
}
