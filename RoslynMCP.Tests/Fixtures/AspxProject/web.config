<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <add key="CdnRoot" value="https://cdn.example.test" />
    <add key="RetryCount" value="3" />
    <add key="DeadSetting" value="nothing reads this" />
    <add key="WrappedSetting" value="read through a method of our own" />
  </appSettings>
  <connectionStrings>
    <add name="Main" connectionString="Server=.;Database=Demo" providerName="System.Data.SqlClient" />
    <add name="WrappedConnection" connectionString="Server=.;Database=Wrapped" />
  </connectionStrings>
  <system.web>
    <pages>
      <controls>
        <add tagPrefix="app" namespace="AspxProject" />
        <add tagPrefix="uc" namespace="AspxProject.Controls" />
      </controls>
      <namespaces>
        <add namespace="AspxProject" />
        <add namespace="System.Collections.Generic" />
      </namespaces>
    </pages>
  </system.web>
</configuration>
