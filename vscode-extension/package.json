{
  "name": "roslyn-sense",
  "displayName": "RoslynSense",
  "description": "C# language server backed by the RoslynSense shared daemon — the same loaded solution your MCP-connected AI assistant uses.",
  "version": "0.2.0",
  "publisher": "roslyn-sense",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers",
    "Testing"
  ],
  "activationEvents": [
    "onLanguage:csharp",
    "onLanguage:webforms",
    "onLanguage:resx",
    "onLanguage:proto",
    "onLanguage:msbuild",
    "workspaceContains:**/*.{sln,slnx,csproj}"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "cs-embedded",
        "aliases": [
          "Embedded C#"
        ]
      },
      {
        "id": "webforms",
        "aliases": [
          "WebForms",
          "ASP.NET WebForms"
        ],
        "extensions": [
          ".aspx",
          ".ascx",
          ".master",
          ".asax",
          ".ashx",
          ".asmx"
        ],
        "firstLine": "^\\s*<%@",
        "configuration": "./language-configuration/webforms.json"
      },
      {
        "id": "resx",
        "aliases": [
          "RESX"
        ],
        "extensions": [
          ".resx"
        ],
        "configuration": "./language-configuration/resx.json"
      },
      {
        "id": "proto",
        "aliases": [
          "Protocol Buffers",
          "protobuf"
        ],
        "extensions": [
          ".proto"
        ],
        "configuration": "./language-configuration/proto.json"
      },
      {
        "id": "msbuild",
        "aliases": [
          "MSBuild"
        ],
        "extensions": [
          ".csproj",
          ".fsproj",
          ".vbproj",
          ".props",
          ".targets"
        ],
        "filenamePatterns": [
          "**/[pP]ackages.[cC]onfig",
          "**/[nN]u[gG]et.[cC]onfig"
        ],
        "configuration": "./language-configuration/msbuild.json"
      }
    ],
    "grammars": [
      {
        "language": "cs-embedded",
        "scopeName": "source.cs-embedded",
        "path": "./syntaxes/csharpEmbedded.tmLanguage.json"
      },
      {
        "language": "webforms",
        "scopeName": "text.html.webforms",
        "path": "./syntaxes/webforms.tmLanguage.json",
        "embeddedLanguages": {
          "text.html": "html",
          "source.cs-embedded": "cs-embedded",
          "source.sql": "sql",
          "text.xml": "xml",
          "source.js": "javascript",
          "source.json": "json",
          "source.css": "css"
        }
      },
      {
        "language": "resx",
        "scopeName": "text.xml.resx",
        "path": "./syntaxes/resx.tmLanguage.json"
      },
      {
        "language": "proto",
        "scopeName": "source.proto",
        "path": "./syntaxes/proto.tmLanguage.json"
      },
      {
        "language": "msbuild",
        "scopeName": "text.xml.msbuild",
        "path": "./syntaxes/msbuild.tmLanguage.json"
      },
      {
        "scopeName": "text.xml.msbuild.expression",
        "path": "./syntaxes/msbuild.expression.json",
        "injectTo": [
          "text.xml.msbuild"
        ]
      }
    ],
    "xmlLanguageParticipants": [
      {
        "languageId": "msbuild"
      }
    ],
    "themes": [
      {
        "label": "RoslynSense Rider Islands Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/rider-islands-dark.json"
      }
    ],
    "semanticTokenTypes": [
      {
        "id": "field",
        "superType": "property",
        "description": "A C# field. Split out from `variable` so it can be coloured apart from locals and parameters."
      },
      {
        "id": "constant",
        "superType": "variable",
        "description": "A C# const field or const local."
      },
      {
        "id": "local",
        "superType": "variable",
        "description": "A C# local variable, as distinct from a field."
      },
      {
        "id": "delegate",
        "superType": "type",
        "description": "A C# delegate type."
      },
      {
        "id": "extensionMethod",
        "superType": "method",
        "description": "A method invoked in extension form."
      }
    ],
    "semanticTokenModifiers": [
      {
        "id": "reassigned",
        "description": "A local or parameter that is written to after its initial assignment."
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "csharp",
        "scopes": {
          "field": ["variable.other.property"],
          "constant": ["variable.other.constant"],
          "local": ["variable.other.readwrite"],
          "delegate": ["entity.name.type.delegate"],
          "extensionMethod": ["entity.name.function"]
        }
      }
    ],
    "commands": [
      {
        "command": "roslynSense.searchEverywhere",
