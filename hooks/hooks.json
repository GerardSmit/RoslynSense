{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/drain-notifications.mjs\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__.*RoslynSense.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/drain-notifications.mjs\""
          }
        ]
      }
    ]
  }
}
