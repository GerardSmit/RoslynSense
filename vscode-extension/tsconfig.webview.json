{
  // The NuGet panel's browser-side script. `module: none` plus `outFile` makes tsc order and
  // concatenate the sources by their /// <reference> graph, so the panel gets one script file
  // with full type checking and no bundler.
  "compilerOptions": {
    "module": "none",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "outFile": "out/webview/nuget.js",
    "sourceMap": false,
    "strict": true,
    "skipLibCheck": true
  },
  "files": ["src/nuget/protocol.d.ts", "src/webview/nuget/main.ts"]
}
