<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.web>
    <pages>
      <controls>
        <add tagPrefix="app" namespace="AspxProject" />
        <add tagPrefix="uc" namespace="AspxProject.Controls" />
      </controls>
      <namespaces>
        <add namespace="AspxProject" />
        <add namespace="System.Collections.Generic" />
      </namespaces>
    </pages>
  </system.web>
</configuration>
