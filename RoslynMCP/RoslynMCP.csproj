<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>roslyn-sense</ToolCommandName>
        <PackageId>RoslynSense</PackageId>
        <VersionPrefix>0.1.0</VersionPrefix>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <Description>Roslyn-powered MCP server for C# code analysis and navigation.</Description>
        <Authors>GerardSmit</Authors>
    </PropertyGroup>

    <ItemGroup>
      <!-- Full-fidelity XML: every character of the source is in the tree, so a span points at the
           exact characters in the buffer and an edit rewrites one value without reformatting the
           file. Error-tolerant, which is what an open document needs — `Version="` with no closing
           quote still parses, and the attribute node is still there to complete against. -->
      <PackageReference Include="GerardSmit.Language.Xml" Version="2.1.0" />
      <PackageReference Include="ICSharpCode.Decompiler" Version="10.1.1.8388" />
      <PackageReference Include="JsonPath.Net" Version="2.1.1" />
      <PackageReference Include="Microsoft.AspNetCore.Razor.Language" Version="6.0.36" />
      <PackageReference Include="Microsoft.Build.Framework" Version="17.11.48" ExcludeAssets="runtime" PrivateAssets="all" />
      <!-- Item-model evaluation: DependentUpon, PackageReference, imports. Runtime assets
           excluded so it binds to the MSBuild that Microsoft.Build.Locator registered, exactly
           like Build.Framework above. -->
      <PackageReference Include="Microsoft.Build" Version="17.11.48" ExcludeAssets="runtime" PrivateAssets="all" />
      <PackageReference Include="Microsoft.Build.Locator" Version="1.11.2" />
      <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Features" Version="5.6.0" />
      <!-- Pulled in by StreamJsonRpc via MessagePack; MSBuildLocator (MSBL001) requires the MSBuild-owned assembly be excluded at runtime. -->
      <PackageReference Include="Microsoft.NET.StringTools" Version="18.4.0" ExcludeAssets="runtime" PrivateAssets="all" />
      <PackageReference Include="Microsoft.CodeAnalysis.Common" Version="5.6.0" />
      <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" />
      <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.6.0" />
      <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.6.0" />
      <!-- Reads and writes .sln and .slnx. The same library Visual Studio and `dotnet sln` use,
           which is the point: solution folders, nesting and solution items are format details
           worth getting from the implementation that defines them rather than reimplementing. -->
      <PackageReference Include="Microsoft.VisualStudio.SolutionPersistence" Version="1.0.52" />
      <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
      <PackageReference Include="Microsoft.Diagnostics.NETCore.Client" Version="0.2.661903" />
      <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
      <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
      <PackageReference Include="ModelContextProtocol" Version="1.2.0" />
      <PackageReference Include="Npgsql" Version="10.0.3" />
      <!-- Package management. Protocol pulls Configuration/Packaging/Versioning/Frameworks;
           going through the real NuGet client is what makes NuGet.config sources, private
           feeds, and credential providers work the same as they do on the command line. -->
      <PackageReference Include="NuGet.Protocol" Version="6.14.3" />
      <!-- The credential provider chain NuGet itself uses: NuGet.config credentials first, then
           the plugin providers Azure Artifacts and friends install. Without it a private feed
           answers 401 and the panel has nothing to say about why. -->
      <PackageReference Include="NuGet.Credentials" Version="6.14.3" />
      <!-- MSBuild owns NuGet.Frameworks at runtime (MSBL001); the located MSBuild supplies it,
           exactly as with Microsoft.NET.StringTools above. -->
      <PackageReference Include="NuGet.Frameworks" Version="6.14.3" ExcludeAssets="runtime" PrivateAssets="all" />
      <!-- Direct pin: Microsoft.Data.Sqlite still resolves 2.1.11, which carries GHSA-2m69-gcr7-jv3q. -->
      <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
      <PackageReference Include="StreamJsonRpc" Version="2.25.29" />
      <PackageReference Include="Krafs.Publicizer" Version="2.3.0" PrivateAssets="all" ExcludeAssets="runtime" />
    </ItemGroup>

    <!-- Compile-time access to Roslyn internals (inlay hints, MEF export provider, signature
         help). Publicizer rewrites the reference assemblies so internals are visible to the
         compiler and emits IgnoresAccessChecksTo, which the runtime honors. Typed calls into
         internals break at build on a Roslyn upgrade instead of silently at runtime. -->
    <ItemGroup>
      <Publicize Include="Microsoft.CodeAnalysis.Features" />
      <Publicize Include="Microsoft.CodeAnalysis.CSharp.Features" />
      <Publicize Include="Microsoft.CodeAnalysis.Workspaces" />
      <!-- BuildHost reuse. MSBuildProjectLoader builds a fresh BuildHostProcessManager for every
           top-level OpenProject/OpenSolution call and disposes it on return, so each one pays a
           cold MSBuild initialisation (~945ms) on top of the evaluation it actually needs (~354ms).
           The internal LoadInfosAsync overload takes an IProjectFileInfoProvider, which is the seam
           for handing it a long-lived one. -->
      <Publicize Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" />
      <Publicize Include="Microsoft.CodeAnalysis.Workspaces.MSBuild.Contracts" />
    </ItemGroup>

    <ItemGroup>
      <None Include="..\README.md" Pack="true" PackagePath="\" Link="README.md" />
    </ItemGroup>

    <!-- MSBuild's own documentation, read by the project-file pack's completion and hover.
         Embedded rather than copied beside the binary: this ships as a tool package, where a
         loose file is one more thing to declare, publish and find at runtime. Provenance and
         licence are in Languages/MsBuild/Help/README.md. -->
    <ItemGroup>
      <EmbeddedResource Include="Languages\MsBuild\Help\*.json" />
    </ItemGroup>

    <!--
      ICorDebug cannot attach across x86/x64, so a target whose bitness differs from this host is
      debugged through a worker of the target's bitness. The RID's apphost is what fixes a
      worker's bitness, so each must be published separately and shipped beside the tool.

      Framework-dependent on purpose: a self-contained x86 publish would add tens of megabytes to
      the package. The cost is that debugging a 32-bit target needs the x86 .NET runtime installed,
      which DebugEngineFactory reports plainly when the worker is missing.

      Set BuildDebugWorkers=false to skip this (it slows inner-loop builds and is only needed when
      actually debugging a cross-bitness target).
    -->
    <PropertyGroup>
      <BuildDebugWorkers Condition="'$(BuildDebugWorkers)' == ''">false</BuildDebugWorkers>
      <BuildDebugWorkers Condition="'$(Configuration)' == 'Release'">true</BuildDebugWorkers>
    </PropertyGroup>

    <PropertyGroup>
      <DebugWorkerStagingDir>$(MSBuildThisFileDirectory)$(BaseIntermediateOutputPath)debugworkers\$(Configuration)\</DebugWorkerStagingDir>
    </PropertyGroup>

    <!-- Publishes both flavours once into a staging directory, shared by build and publish. -->
    <Target Name="PublishDebugWorkers" Condition="'$(BuildDebugWorkers)' == 'true' AND '$(OS)' == 'Windows_NT' AND '$(_RoslynMcpInnerWorkerBuild)' != 'true'">
      <MSBuild Projects="..\RoslynMCP.DebugWorker\RoslynMCP.DebugWorker.csproj" Targets="Publish" Properties="Configuration=$(Configuration);RuntimeIdentifier=win-x64;SelfContained=false;PublishDir=$(DebugWorkerStagingDir)x64\;_RoslynMcpInnerWorkerBuild=true" />
      <MSBuild Projects="..\RoslynMCP.DebugWorker\RoslynMCP.DebugWorker.csproj" Targets="Publish" Properties="Configuration=$(Configuration);RuntimeIdentifier=win-x86;SelfContained=false;PublishDir=$(DebugWorkerStagingDir)x86\;_RoslynMcpInnerWorkerBuild=true" />
    </Target>

    <!-- Beside the build output, so a locally built server and the tests can find the workers. -->
    <Target Name="CopyDebugWorkersToOutput" AfterTargets="Build" DependsOnTargets="PublishDebugWorkers" Condition="'$(BuildDebugWorkers)' == 'true' AND '$(OS)' == 'Windows_NT' AND '$(_RoslynMcpInnerWorkerBuild)' != 'true'">
      <ItemGroup>
        <_StagedDebugWorker Include="$(DebugWorkerStagingDir)**\*" />
      </ItemGroup>
      <Copy SourceFiles="@(_StagedDebugWorker)" DestinationFiles="@(_StagedDebugWorker->'$(OutputPath)workers\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    </Target>

    <!--
      Into the publish output, which is what `PackAsTool` actually packages — adding None items
      with a tools\ PackagePath does not work for a tool package.
    -->
    <Target Name="AddDebugWorkersToPublish" AfterTargets="ComputeFilesToPublish" DependsOnTargets="PublishDebugWorkers" Condition="'$(BuildDebugWorkers)' == 'true' AND '$(OS)' == 'Windows_NT' AND '$(_RoslynMcpInnerWorkerBuild)' != 'true'">
      <ItemGroup>
        <_StagedDebugWorker Include="$(DebugWorkerStagingDir)**\*" />
        <ResolvedFileToPublish Include="@(_StagedDebugWorker)">
          <RelativePath>workers\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
          <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </ResolvedFileToPublish>
      </ItemGroup>
    </Target>

    <!--
      The hot reload agent is injected into the *user's* process through DOTNET_STARTUP_HOOKS, so
      it is shipped as a payload rather than referenced: nothing here calls into it, and it targets
      net6.0 so one build loads on every runtime a user's app might be on.
    -->
    <Target Name="CopyHotReloadAgent" AfterTargets="Build">
      <!-- RemoveProperties: the agent is net6.0. During the tool's publish/pack the outer build
           carries TargetFramework=net10.0 (and NoBuild when packing without a build) as global
           properties, which otherwise leak into this nested build and fail it
           (NETSDK1005 / NETSDK1085). -->
      <MSBuild Projects="..\RoslynMCP.HotReloadAgent\RoslynMCP.HotReloadAgent.csproj" Targets="Build" Properties="Configuration=$(Configuration)" RemoveProperties="TargetFramework;NoBuild;RuntimeIdentifier;SelfContained">
        <Output TaskParameter="TargetOutputs" ItemName="_HotReloadAgentOutput" />
      </MSBuild>
      <Copy SourceFiles="@(_HotReloadAgentOutput)" DestinationFolder="$(OutputPath)hotreload" SkipUnchangedFiles="true" />
    </Target>

    <Target Name="AddHotReloadAgentToPublish" AfterTargets="ComputeFilesToPublish">
      <!-- See CopyHotReloadAgent: strip the outer TFM/publish globals so the net6.0 agent builds
           as itself rather than being forced to net10.0 (or refused when packing without a
           build). -->
      <MSBuild Projects="..\RoslynMCP.HotReloadAgent\RoslynMCP.HotReloadAgent.csproj" Targets="Build" Properties="Configuration=$(Configuration)" RemoveProperties="TargetFramework;NoBuild;RuntimeIdentifier;SelfContained">
        <Output TaskParameter="TargetOutputs" ItemName="_HotReloadAgentPublish" />
      </MSBuild>
      <ItemGroup>
        <ResolvedFileToPublish Include="@(_HotReloadAgentPublish)">
          <RelativePath>hotreload\%(Filename)%(Extension)</RelativePath>
          <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </ResolvedFileToPublish>
      </ItemGroup>
    </Target>

    <!--
      The tray icon, shipped as a payload beside the tool rather than referenced. It is a WinForms
      app on net10.0-windows and this tool is cross-platform net10.0, so a ProjectReference would
      make the whole package Windows-only; the daemon starts it by path (Host/TrayLauncher.cs) and
      simply does without when the file is absent, which is what a non-Windows publish produces.

      Set BuildTrayIcon=false to skip it.
    -->
    <PropertyGroup>
      <BuildTrayIcon Condition="'$(BuildTrayIcon)' == ''">true</BuildTrayIcon>
      <TrayStagingDir>$(MSBuildThisFileDirectory)$(BaseIntermediateOutputPath)tray\$(Configuration)\</TrayStagingDir>
      <_BuildTrayIcon>false</_BuildTrayIcon>
      <_BuildTrayIcon Condition="'$(BuildTrayIcon)' == 'true' AND '$(OS)' == 'Windows_NT'">true</_BuildTrayIcon>
    </PropertyGroup>

    <!-- Published, not built: the tray has to be launchable from the staging directory, which
         means the apphost, deps.json and runtimeconfig.json alongside the assembly. -->
    <Target Name="PublishTrayIcon" Condition="'$(_BuildTrayIcon)' == 'true'">
      <!-- As with the hot reload agent: strip the outer TFM and publish globals so the tray
           builds as net10.0-windows rather than being forced to this project's net10.0. -->
      <MSBuild Projects="..\RoslynSense.Tray\RoslynSense.Tray.csproj" Targets="Publish"
               Properties="Configuration=$(Configuration);PublishDir=$(TrayStagingDir)"
               RemoveProperties="TargetFramework;NoBuild;RuntimeIdentifier;SelfContained;PublishProfile" />
    </Target>

    <Target Name="CopyTrayIconToOutput" AfterTargets="Build" DependsOnTargets="PublishTrayIcon" Condition="'$(_BuildTrayIcon)' == 'true'">
      <ItemGroup>
        <_StagedTray Include="$(TrayStagingDir)**\*" />
      </ItemGroup>
      <Copy SourceFiles="@(_StagedTray)" DestinationFiles="@(_StagedTray->'$(OutputPath)tray\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    </Target>

    <Target Name="AddTrayIconToPublish" AfterTargets="ComputeFilesToPublish" DependsOnTargets="PublishTrayIcon" Condition="'$(_BuildTrayIcon)' == 'true'">
      <ItemGroup>
        <_StagedTray Include="$(TrayStagingDir)**\*" />
        <ResolvedFileToPublish Include="@(_StagedTray)">
          <RelativePath>tray\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
          <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </ResolvedFileToPublish>
      </ItemGroup>
    </Target>

    <ItemGroup>
      <ProjectReference Include="..\WebFormsCore.Parser\WebFormsCore.Parser.csproj" />
      <ProjectReference Include="..\RoslynMCP.Debugger\RoslynMCP.Debugger.csproj" />
    </ItemGroup>

</Project>
