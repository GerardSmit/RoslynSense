<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ProtoSolution.Server</RootNamespace>
  </PropertyGroup>

  <!--
    The reference that makes this fixture worth having: the .proto and its generated code are in
    Contracts, the implementation is here, and the only path from one to the other is this element.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Contracts\Contracts.csproj" />
  </ItemGroup>

</Project>
