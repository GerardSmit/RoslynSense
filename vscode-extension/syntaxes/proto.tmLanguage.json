{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Protocol Buffers",
  "scopeName": "source.proto",
  "fileTypes": [
    "proto"
  ],
  "comment": "Written from the Protocol Buffers language specification. Blocks, statements and literals are scoped confidently; a bare identifier that the server can bind is scoped only as broadly as the syntax proves, so the semantic token layer stays the authority on what a name actually is.",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#syntax-statement"
    },
    {
      "include": "#package-statement"
    },
    {
      "include": "#import-statement"
    },
    {
      "include": "#option-statement"
    },
    {
      "include": "#message-block"
    },
    {
      "include": "#enum-block"
    },
    {
      "include": "#service-block"
    },
    {
      "include": "#extend-block"
    },
    {
      "include": "#terminator"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.proto",
          "begin": "//",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.proto"
            }
          },
          "end": "(?=$)"
        },
        {
          "name": "comment.block.proto",
          "begin": "/\\*",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.begin.proto"
            }
          },
          "end": "\\*/",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.end.proto"
            }
          }
        }
      ]
    },
    "syntax-statement": {
      "begin": "\\b(?:(syntax)|(edition))\\b\\s*(=)?",
      "beginCaptures": {
        "1": {
          "name": "keyword.other.syntax.proto"
        },
        "2": {
          "name": "keyword.other.edition.proto"
        },
        "3": {
          "name": "keyword.operator.assignment.proto"
        }
      },
      "end": "(;)|(?=$)",
      "endCaptures": {
        "1": {
          "name": "punctuation.terminator.statement.proto"
        }
      },
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#strings"
        }
      ]
    },
    "package-statement": {
      "match": "\\b(package)\\b\\s*(\\.?[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*)?\\s*(;)?",
      "captures": {
        "1": {
          "name": "keyword.other.package.proto"
        },
        "2": {
          "name": "entity.name.namespace.proto"
        },
        "3": {
          "name": "punctuation.terminator.statement.proto"
        }
      }
    },
    "import-statement": {
      "begin": "\\b(import)\\b(?:\\s+(public|weak)\\b)?",
      "beginCaptures": {
        "1": {
          "name": "keyword.other.import.proto"
        },
        "2": {
          "name": "keyword.other.import-modifier.proto"
        }
      },
      "end": "(;)|(?=$)",
      "endCaptures": {
        "1": {
          "name": "punctuation.terminator.statement.proto"
        }
      },
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#strings"
        }
      ]
    },
    "option-statement": {
      "begin": "\\b(option)\\b\\s*(?:(\\()\\s*(\\.?[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*)\\s*(\\))|([A-Za-z_][A-Za-z0-9_]*))?((?:\\.[A-Za-z_][A-Za-z0-9_]*)*)\\s*(=)?",
      "beginCaptures": {
        "1": {
          "name": "keyword.other.option.proto"
        },
        "2": {
          "name": "punctuation.definition.option.begin.proto"
        },
        "3": {
          "name": "variable.other.option.proto"
        },
        "4": {
          "name": "punctuation.definition.option.end.proto"
        },
        "5": {
          "name": "variable.other.option.proto"
        },
        "6": {
          "name": "variable.other.option.proto"
        },
        "7": {
          "name": "keyword.operator.assignment.proto"
        }
      },
      "end": "(;)|(?=\\})|(?=$)",
      "endCaptures": {
        "1": {
          "name": "punctuation.terminator.statement.proto"
        }
      },
      "patterns": [
        {
          "include": "#option-value"
        }
      ]
    },
    "option-value": {
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#option-aggregate"
        },
        {
          "include": "#option-aggregate-angle"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#language-constants"
        },
        {
          "name": "constant.other.enum.proto",
          "match": "\\.?[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*"
        },
        {
          "include": "#assignment"
        }
      ]
    },
    "option-aggregate": {
      "begin": "\\{",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.block.begin.proto"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.block.end.proto"
        }
      },
      "patterns": [
        {
          "include": "#option-aggregate-body"
        }
      ]
    },
    "option-aggregate-angle": {
      "comment": "The text format accepts <> wherever it accepts {} for a nested message value.",
      "begin": "<",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.block.begin.proto"
        }
      },
      "end": ">",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.block.end.proto"
        }
      },
      "patterns": [
        {
          "include": "#option-aggregate-body"
        }
      ]
    },
    "option-aggregate-body": {
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "match": "(\\()\\s*(\\.?[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*)\\s*(\\))((?:\\.[A-Za-z_][A-Za-z0-9_]*)*)",
          "captures": {
            "1": {
              "name": "punctuation.definition.option.begin.proto"
            },
            "2": {
              "name": "variable.other.option.proto"
            },
            "3": {
              "name": "punctuation.definition.option.end.proto"
            },
            "4": {
              "name": "variable.other.option.proto"
            }
          }
        },
        {
          "comment": "An extension key. The lookahead keeps a list value out of this rule, since both open with [.",
          "match": "(\\[)\\s*(\\.?[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*)\\s*(\\])((?:\\.[A-Za-z_][A-Za-z0-9_]*)*)(?=\\s*[:\\{<])",
          "captures": {
            "1": {
              "name": "punctuation.definition.option.begin.proto"
            },
            "2": {
              "name": "variable.other.option.proto"
            },
            "3": {
              "name": "punctuation.definition.option.end.proto"
            },
            "4": {
              "name": "variable.other.option.proto"
            }
          }
        },
        {
          "name": "variable.other.option.proto",
          "match": "\\.?[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*(?=\\s*[:\\{<])"
        },
        {
          "include": "#key-value"
        },
        {
          "include": "#option-aggregate"
        },
        {
          "include": "#option-aggregate-angle"
        },
        {
          "include": "#option-list"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#language-constants"
        },
        {
          "name": "constant.other.enum.proto",
          "match": "\\.?[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*"
        },
        {
          "include": "#comma"
        },
        {
          "include": "#terminator"
        }
      ]
    },
    "option-list": {
      "begin": "\\[",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.brackets.begin.proto"
        }
      },
      "end": "\\]",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.brackets.end.proto"
        }
      },
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#option-aggregate"
        },
        {
          "include": "#option-aggregate-angle"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#language-constants"
        },
        {
          "name": "constant.other.enum.proto",
          "match": "\\.?[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*"
        },
        {
          "include": "#comma"
        }
      ]
    },
    "message-block": {
      "begin": "\\b(message)\\b\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "beginCaptures": {
        "1": {
          "name": "storage.type.message.proto"
        },
        "2": {
          "name": "entity.name.type.message.proto"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.block.end.proto"
        }
      },
      "patterns": [
        {
          "include": "#message-body"
        }
      ]
    },
    "message-body": {
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#block-open"
        },
        {
          "include": "#option-statement"
        },
        {
          "include": "#reserved-statement"
        },
        {
          "include": "#extensions-statement"
        },
        {
          "include": "#message-block"
        },
        {
          "include": "#enum-block"
        },
        {
          "include": "#oneof-block"
        },
        {
          "include": "#extend-block"
        },
        {
          "include": "#group-block"
        },
        {
          "include": "#map-field"
        },
        {
          "include": "#field"
        },
        {
          "include": "#terminator"
        }
      ]
    },
    "enum-block": {
      "begin": "\\b(enum)\\b\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "beginCaptures": {
        "1": {
          "name": "storage.type.enum.proto"
        },
        "2": {
          "name": "entity.name.type.enum.proto"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.block.end.proto"
        }
      },
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#block-open"
        },
        {
          "include": "#option-statement"
        },
        {
          "include": "#reserved-statement"
        },
        {
          "include": "#enum-value"
        },
        {
          "include": "#terminator"
        }
      ]
    },
    "enum-value": {
      "comment": "The number is optional so a value keeps its colour while it is still being typed. The = is not, since that is what separates a value from every other statement an enum body can hold.",
      "begin": "(?!\\b(?:option|reserved)\\b)\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(=)\\s*([+-]?(?:0[xX][0-9A-Fa-f]+|[0-9]+))?",
      "beginCaptures": {
        "1": {
          "name": "constant.other.enum.proto"
        },
        "2": {
          "name": "keyword.operator.assignment.proto"
        },
        "3": {
          "name": "constant.numeric.proto"
        }
      },
      "end": "(;)|(?=\\})|(?=$)",
      "endCaptures": {
        "1": {
          "name": "punctuation.terminator.statement.proto"
        }
      },
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#field-options"
        }
      ]
    },
    "service-block": {
      "begin": "\\b(service)\\b\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "beginCaptures": {
        "1": {
          "name": "storage.type.service.proto"
        },
        "2": {
          "name": "entity.name.type.service.proto"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.block.end.proto"
        }
      },
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#block-open"
        },
        {
          "include": "#option-statement"
        },
        {
          "include": "#rpc"
        },
        {
          "include": "#terminator"
        }
      ]
    },
    "rpc": {
      "begin": "\\b(rpc)\\b\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "beginCaptures": {
        "1": {
          "name": "storage.type.rpc.proto"
        },
        "2": {
          "name": "entity.name.function.proto"
        }
      },
      "end": "(;)|(?<=\\})|(?=\\})",
      "endCaptures": {
        "1": {
          "name": "punctuation.terminator.statement.proto"
        }
      },
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#rpc-signature"
        },
        {
          "name": "keyword.other.returns.proto",
          "match": "\\b(?:returns)\\b"
        },
        {
          "include": "#rpc-body"
        }
      ]
    },
    "rpc-signature": {
      "begin": "\\(",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.parameters.begin.proto"
        }
      },
      "end": "\\)",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.parameters.end.proto"
        }
      },
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "name": "keyword.other.stream.proto",
          "match": "\\b(?:stream)\\b"
        },
        {
          "include": "#builtin-types"
        },
        {
          "include": "#type-reference"
        }
      ]
    },
    "rpc-body": {
      "begin": "\\{",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.block.begin.proto"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.block.end.proto"
        }
      },
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#option-statement"
        },
        {
          "include": "#terminator"
        }
      ]
    },
    "oneof-block": {
      "begin": "\\b(oneof)\\b\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "beginCaptures": {
        "1": {
          "name": "storage.type.oneof.proto"
        },
        "2": {
          "name": "variable.other.field.proto"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.block.end.proto"
        }
      },
      "patterns": [
        {
          "include": "#message-body"
        }
      ]
    },
    "extend-block": {
      "begin": "\\b(extend)\\b\\s+(\\.?[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*)",
      "beginCaptures": {
        "1": {
          "name": "storage.type.extend.proto"
        },
        "2": {
          "name": "entity.name.type.proto"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.block.end.proto"
        }
      },
      "patterns": [
