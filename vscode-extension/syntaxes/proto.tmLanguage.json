    "map-field": {
      "begin": "\\b(map)\\b\\s*(<)",
      "beginCaptures": {
        "1": {
          "name": "storage.type.map.proto"
        },
        "2": {
          "name": "punctuation.definition.typeparameters.begin.proto"
        }
      },
      "end": "(;)|(?=\\})",
      "endCaptures": {
        "1": {
          "name": "punctuation.terminator.statement.proto"
