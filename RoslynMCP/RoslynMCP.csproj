<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>roslyn-sense</ToolCommandName>
        <PackageId>RoslynSense</PackageId>
        <VersionPrefix>0.1.0</VersionPrefix>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <Description>Roslyn-powered MCP server for C# code analysis and navigation.</Description>
        <Authors>GerardSmit</Authors>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="ICSharpCode.Decompiler" Version="10.1.1.8388" />
      <PackageReference Include="JsonPath.Net" Version="2.1.1" />
      <PackageReference Include="Microsoft.AspNetCore.Razor.Language" Version="6.0.36" />
      <PackageReference Include="Microsoft.Build.Framework" Version="17.11.48" ExcludeAssets="runtime" PrivateAssets="all" />
      <!-- Item-model evaluation (DependentUpon, PackageReference, imports) and .sln parsing for
           the Solution Explorer. Runtime assets excluded so it binds to the MSBuild that
           Microsoft.Build.Locator registered, exactly like Build.Framework above. -->
      <PackageReference Include="Microsoft.Build" Version="17.11.48" ExcludeAssets="runtime" PrivateAssets="all" />
      <PackageReference Include="Microsoft.Build.Locator" Version="1.11.2" />
      <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Features" Version="5.6.0" />
      <!-- Pulled in by StreamJsonRpc via MessagePack; MSBuildLocator (MSBL001) requires the MSBuild-owned assembly be excluded at runtime. -->
      <PackageReference Include="Microsoft.NET.StringTools" Version="18.4.0" ExcludeAssets="runtime" PrivateAssets="all" />
      <PackageReference Include="Microsoft.CodeAnalysis.Common" Version="5.6.0" />
      <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" />
      <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.6.0" />
      <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.6.0" />
      <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
      <PackageReference Include="Microsoft.Diagnostics.NETCore.Client" Version="0.2.661903" />
      <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
      <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
      <PackageReference Include="ModelContextProtocol" Version="1.2.0" />
      <PackageReference Include="Npgsql" Version="10.0.3" />
      <!-- Package management. Protocol pulls Configuration/Packaging/Versioning/Frameworks;
           going through the real NuGet client is what makes NuGet.config sources, private
           feeds, and credential providers work the same as they do on the command line. -->
      <PackageReference Include="NuGet.Protocol" Version="6.14.0" />
      <!-- MSBuild owns NuGet.Frameworks at runtime (MSBL001); the located MSBuild supplies it,
           exactly as with Microsoft.NET.StringTools above. -->
      <PackageReference Include="NuGet.Frameworks" Version="6.14.0" ExcludeAssets="runtime" PrivateAssets="all" />
      <!-- Direct pin: Microsoft.Data.Sqlite still resolves 2.1.11, which carries GHSA-2m69-gcr7-jv3q. -->
      <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
      <PackageReference Include="StreamJsonRpc" Version="2.25.29" />
      <PackageReference Include="Krafs.Publicizer" Version="2.3.0" PrivateAssets="all" ExcludeAssets="runtime" />
    </ItemGroup>

    <!-- Compile-time access to Roslyn internals (inlay hints, MEF export provider, signature
         help). Publicizer rewrites the reference assemblies so internals are visible to the
         compiler and emits IgnoresAccessChecksTo, which the runtime honors. Typed calls into
         internals break at build on a Roslyn upgrade instead of silently at runtime. -->
    <ItemGroup>
      <Publicize Include="Microsoft.CodeAnalysis.Features" />
      <Publicize Include="Microsoft.CodeAnalysis.CSharp.Features" />
      <Publicize Include="Microsoft.CodeAnalysis.Workspaces" />
    </ItemGroup>

    <ItemGroup>
      <None Include="..\README.md" Pack="true" PackagePath="\" Link="README.md" />
    </ItemGroup>

    <!--
      ICorDebug cannot attach across x86/x64, so a target whose bitness differs from this host is
      debugged through a worker of the target's bitness. The RID's apphost is what fixes a
      worker's bitness, so each must be published separately and shipped beside the tool.

      Framework-dependent on purpose: a self-contained x86 publish would add tens of megabytes to
      the package. The cost is that debugging a 32-bit target needs the x86 .NET runtime installed,
      which DebugEngineFactory reports plainly when the worker is missing.

      Set BuildDebugWorkers=false to skip this (it slows inner-loop builds and is only needed when
      actually debugging a cross-bitness target).
    -->
    <PropertyGroup>
      <BuildDebugWorkers Condition="'$(BuildDebugWorkers)' == ''">false</BuildDebugWorkers>
      <BuildDebugWorkers Condition="'$(Configuration)' == 'Release'">true</BuildDebugWorkers>
    </PropertyGroup>

    <PropertyGroup>
      <DebugWorkerStagingDir>$(MSBuildThisFileDirectory)$(BaseIntermediateOutputPath)debugworkers\$(Configuration)\</DebugWorkerStagingDir>
    </PropertyGroup>

    <!-- Publishes both flavours once into a staging directory, shared by build and publish. -->
    <Target Name="PublishDebugWorkers" Condition="'$(BuildDebugWorkers)' == 'true' AND '$(OS)' == 'Windows_NT' AND '$(_RoslynMcpInnerWorkerBuild)' != 'true'">
      <MSBuild Projects="..\RoslynMCP.DebugWorker\RoslynMCP.DebugWorker.csproj" Targets="Publish" Properties="Configuration=$(Configuration);RuntimeIdentifier=win-x64;SelfContained=false;PublishDir=$(DebugWorkerStagingDir)x64\;_RoslynMcpInnerWorkerBuild=true" />
      <MSBuild Projects="..\RoslynMCP.DebugWorker\RoslynMCP.DebugWorker.csproj" Targets="Publish" Properties="Configuration=$(Configuration);RuntimeIdentifier=win-x86;SelfContained=false;PublishDir=$(DebugWorkerStagingDir)x86\;_RoslynMcpInnerWorkerBuild=true" />
    </Target>

    <!-- Beside the build output, so a locally built server and the tests can find the workers. -->
    <Target Name="CopyDebugWorkersToOutput" AfterTargets="Build" DependsOnTargets="PublishDebugWorkers" Condition="'$(BuildDebugWorkers)' == 'true' AND '$(OS)' == 'Windows_NT' AND '$(_RoslynMcpInnerWorkerBuild)' != 'true'">
      <ItemGroup>
        <_StagedDebugWorker Include="$(DebugWorkerStagingDir)**\*" />
      </ItemGroup>
      <Copy SourceFiles="@(_StagedDebugWorker)" DestinationFiles="@(_StagedDebugWorker->'$(OutputPath)workers\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    </Target>

    <!--
      Into the publish output, which is what `PackAsTool` actually packages — adding None items
      with a tools\ PackagePath does not work for a tool package.
    -->
    <Target Name="AddDebugWorkersToPublish" AfterTargets="ComputeFilesToPublish" DependsOnTargets="PublishDebugWorkers" Condition="'$(BuildDebugWorkers)' == 'true' AND '$(OS)' == 'Windows_NT' AND '$(_RoslynMcpInnerWorkerBuild)' != 'true'">
      <ItemGroup>
        <_StagedDebugWorker Include="$(DebugWorkerStagingDir)**\*" />
        <ResolvedFileToPublish Include="@(_StagedDebugWorker)">
          <RelativePath>workers\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
          <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </ResolvedFileToPublish>
      </ItemGroup>
    </Target>

    <ItemGroup>
      <ProjectReference Include="..\WebFormsCore.Parser\WebFormsCore.Parser.csproj" />
      <ProjectReference Include="..\RoslynMCP.Debugger\RoslynMCP.Debugger.csproj" />
    </ItemGroup>

</Project>
